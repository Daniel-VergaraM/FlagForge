# API (NestJS)
PORT=3001
DATABASE_URL=postgresql://flagforge:flagforge@localhost:5432/flagforge?schema=public
REDIS_URL=redis://localhost:6379
NATS_URL=nats://localhost:4222
# Comma-separated allowlist of origins permitted to call the API cross-origin
# (e.g. the dashboard's own domain). Left unset, CORS denies all cross-origin
# requests rather than reflecting the caller's origin.
CORS_ORIGIN=http://localhost:3000

# Evaluator (Go)
EVALUATOR_PORT=3002
