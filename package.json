{
  "name": "flagforge",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "dev:api": "pnpm --filter @flagforge/api dev",
    "dev:evaluator": "cd apps/evaluator && go run main.go",
    "build:api": "pnpm --filter @flagforge/api build",
    "build:evaluator": "cd apps/evaluator && go build -o evaluator main.go",
    "lint": "pnpm --filter @flagforge/api lint",
    "test": "pnpm --filter @flagforge/api test",
    "test:e2e": "pnpm --filter @flagforge/api test:e2e",
    "db:up": "docker compose up -d",
    "db:migrate": "pnpm --filter @flagforge/api prisma:migrate",
    "db:seed": "pnpm --filter @flagforge/api prisma:seed"
  },
  "devDependencies": {
    "pnpm": "^12.3.4"
  },
  "pnpm": {
    "overrides": {
      "multer": "^2.3.0",
      "minimatch@9>brace-expansion": "^2.1.4",
      "js-yaml": "^4.3.1",
      "lodash": "^4.18.0",
      "rimraf@5>glob": "^10.5.0"
    }
  }
}
