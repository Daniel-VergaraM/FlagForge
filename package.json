{
  "name": "flagforge",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "dev:api": "pnpm --filter @flagforge/api dev",
    "dev:evaluator": "cd apps/evaluator && go run main.go",
    "build:api": "pnpm --filter @flagforge/api build",
    "build:evaluator": "cd apps/evaluator && go build -o evaluator main.go",
    "lint": "pnpm --filter @flagforge/api lint",
    "test": "pnpm --filter @flagforge/api test",
    "test:e2e": "pnpm --filter @flagforge/api test:e2e",
    "db:up": "docker compose up -d",
    "db:migrate": "pnpm --filter @flagforge/api prisma:migrate",
    "db:seed": "pnpm --filter @flagforge/api prisma:seed"
  },
  "devDependencies": {
    "pnpm": "^9.0.0"
  },
  "dependencies": {
    "@opentelemetry/auto-instrumentations-node": "^0.76.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.222.0",
    "@opentelemetry/instrumentation-express": "^0.66.0",
    "@opentelemetry/instrumentation-http": "^0.218.0",
    "@opentelemetry/resources": "^2.11.0",
    "@opentelemetry/sdk-node": "^0.218.0",
    "@opentelemetry/sdk-trace-node": "^2.11.0",
    "@opentelemetry/semantic-conventions": "^1.41.1"
  }
}
